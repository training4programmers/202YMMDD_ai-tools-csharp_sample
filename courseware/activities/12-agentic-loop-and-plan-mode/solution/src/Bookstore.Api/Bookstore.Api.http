# Sample requests for the Bookstore API. Start the API first:
#   dotnet run --project src/Bookstore.Api
# then click "Send Request" above any request (Visual Studio 2026, or VS Code with the REST Client extension).
@host = http://localhost:5080

### Health check
GET {{host}}/health

### All books
GET {{host}}/api/books

### Books in one genre
GET {{host}}/api/books?genre=Technology

### One book
GET {{host}}/api/books/1

### Create a book
POST {{host}}/api/books
Content-Type: application/json

{
  "title": "Learning to Listen",
  "isbn": "978-1-23456-009-6",
  "price": 16.50,
  "stock": 8,
  "genre": "NonFiction",
  "publishedOn": "2025-05-01",
  "authorId": 4
}

### Create a book with a bad ISBN check digit (expect 400)
POST {{host}}/api/books
Content-Type: application/json

{
  "title": "Bad Checksum",
  "isbn": "978-1-23456-009-0",
  "price": 10,
  "stock": 1,
  "genre": "Fiction",
  "publishedOn": "2025-05-01",
  "authorId": 1
}

### Authors
GET {{host}}/api/authors

### Price an order
POST {{host}}/api/quotes
Content-Type: application/json

{
  "lines": [
    { "bookId": 5, "quantity": 10 },
    { "bookId": 7, "quantity": 1 }
  ],
  "couponCode": "READMORE"
}

### Place an order (takes the copies off the shelf)
POST {{host}}/api/orders
Content-Type: application/json

{
  "lines": [
    { "bookId": 5, "quantity": 10 },
    { "bookId": 7, "quantity": 1 }
  ],
  "couponCode": "READMORE"
}

### Read an order back
GET {{host}}/api/orders/1

### Order more copies than are in stock (expect 409)
POST {{host}}/api/orders
Content-Type: application/json

{
  "lines": [ { "bookId": 4, "quantity": 1 } ]
}
