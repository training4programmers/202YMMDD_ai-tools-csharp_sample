<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    The pre-optimization search (the reference), the measured candidate, and the sample catalog, so the
    equivalence tests can prove every implementation the benchmark compares returns the same books.
  -->
  <ItemGroup>
    <Compile Include="..\..\benchmarks\Bookstore.Benchmarks\Candidates\*.cs" LinkBase="Reference" />
    <Compile Include="..\..\benchmarks\Bookstore.Benchmarks\SampleCatalog.cs" Link="Reference\SampleCatalog.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Bookstore.Api\Bookstore.Api.csproj" />
    <ProjectReference Include="..\..\src\Bookstore.Domain\Bookstore.Domain.csproj" />
  </ItemGroup>

</Project>
