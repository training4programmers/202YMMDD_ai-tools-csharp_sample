# Sample requests for the ToolsApp colors API. Start the API first:
#   dotnet run --project src/ToolsApp.Api
# then click "Send Request" above any request (Visual Studio 2026, or VS Code with the REST Client extension).
@host = http://localhost:5090

### Health check
GET {{host}}/health

### All colors
GET {{host}}/api/colors

### Colors in one palette
GET {{host}}/api/colors?paletteId=2

### One color
GET {{host}}/api/colors/1

### Contrast of a color against white (the # is URL-encoded as %23)
GET {{host}}/api/colors/4/contrast?against=%23FFFFFF

### Create a color (shorthand hex is normalized to #RRGGBB)
POST {{host}}/api/colors
Content-Type: application/json

{
  "name": "Mint",
  "hex": "#3EB489",
  "paletteId": 2
}

### Create a color with a malformed hex (expect 400)
POST {{host}}/api/colors
Content-Type: application/json

{
  "name": "Not a color",
  "hex": "#GG0000",
  "paletteId": 1
}

### Palettes
GET {{host}}/api/palettes

### Colors in a palette
GET {{host}}/api/palettes/3/colors

### Export a palette as CSS custom properties
GET {{host}}/api/palettes/2/export.css

### Import colors into a palette from CSV (hex or CSS hsl() values)
POST {{host}}/api/palettes/2/import
Content-Type: text/csv

name,value
Kelp,#2E8B57
Sand,f4d8a8
Dune,hsl(38, 76%, 81%)

### Import with a malformed line (expect 400 and nothing saved)
POST {{host}}/api/palettes/2/import
Content-Type: text/csv

Moss,#3A5F0B
Broken,#GG0000
